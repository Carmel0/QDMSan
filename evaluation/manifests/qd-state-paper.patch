+
   if (ctx->input_fd >= 0) {
     close(ctx->input_fd);
     ctx->input_fd = -1;
@@ -1372,7 +1453,7 @@ int main(int argc, char **argv) {
   const char *input_file = NULL;
 
   int opt;
-  while ((opt = getopt(argc, argv, "+q:l:m:c:i:t:C:R:vQh")) != -1) {
+  while ((opt = getopt(argc, argv, "+q:l:m:c:i:t:C:R:SvQh")) != -1) {
     switch (opt) {
